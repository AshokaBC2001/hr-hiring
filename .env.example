# HR Hiring configuration template (copy to .env for hosted/custom environments)
# Real OS environment variables always take precedence over .env values.

# ---- Web Server & Hosting Safeguards -----------------------------------------
HR_APP_HOST=127.0.0.1
HR_APP_PORT=8000
# Set HR_PUBLIC_HOSTING=1 or list comma-separated hostnames (supports .suffix wildcards) when hosting
HR_PUBLIC_HOSTING=0
HR_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
HR_ALLOWED_ORIGINS=

# Optional authentication for hosted supervisor review (browser Basic Auth prompt; zero UI edits needed)
HR_AUTH_USER=
HR_AUTH_PASS=
HR_ACCESS_TOKEN=

# Optional persistent data path (mount a persistent disk here in containers/cloud)
HR_DATA_DIR=

# ---- LLM Configuration (local llama-server OR hosted OpenAI-compatible API) ---
HR_MODEL_URL=http://127.0.0.1:8080
HR_MODEL_NAME=gemma-3-4b-it
HR_MODEL_API_KEY=
HR_MODEL_TIMEOUT=300
HR_MERGE_SYSTEM=1
# Set to 1 if hosting without an LLM server so agents use deterministic rule/template fallbacks cleanly
HR_ALLOW_RULES_ONLY=0
HR_SCHEDULER=1

# ---- Live SMTP Candidate Email Sender ----------------------------------------
HR_SMTP_ENABLED=0
HR_SMTP_HOST=smtp.gmail.com
HR_SMTP_PORT=587
HR_SMTP_USER=
HR_SMTP_PASSWORD=
HR_SMTP_USE_TLS=1
HR_SMTP_USE_SSL=0
HR_SMTP_FROM_NAME=SLT Talent Acquisition
HR_SMTP_FROM_EMAIL=
# Set Demo Recipient Override + HR_DEMO_EMAIL_LOCK=1 when demoing to supervisors!
HR_SMTP_TEST_RECIPIENT=
HR_DEMO_EMAIL_LOCK=0

# ---- SLT TalentHub / MongoDB Accessibility -----------------------------------
# TALENT_HUB_MODE: "auto" (API if URL set, else direct MongoDB), "api", or "mongo"
TALENT_HUB_MODE=auto
TALENT_HUB_MONGO_URI=mongodb://127.0.0.1:27017
TALENT_HUB_DB_NAME=slt_talent_hub_sample
TALENT_HUB_COLLECTION=interns
TALENT_HUB_TIMEOUT_MS=2000
TALENT_HUB_API_URL=http://127.0.0.1:5050/api
TALENT_HUB_API_TOKEN=talenthub-local-dev-token
